{
  "name": "sonora-sound-recorder",
  "productName": "Sonora Sound Recorder",
  "version": "0.2.0",
  "description": "A modern desktop sound recorder for microphone and system audio, with local transcription.",
  "main": "out/main/index.js",
  "author": "demirgitbuh",
  "license": "GPL-3.0-only",
  "homepage": "https://github.com/demirgitbuh/SonoraSoundRecorder",
  "repository": {
    "type": "git",
    "url": "https://github.com/demirgitbuh/SonoraSoundRecorder.git"
  },
  "bugs": {
    "url": "https://github.com/demirgitbuh/SonoraSoundRecorder/issues"
  },
  "private": true,
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "test": "vitest run",
    "fetch:ffmpeg": "node scripts/fetch-ffmpeg.mjs",
    "prepare:resources": "node scripts/prepare-resources.mjs",
    "package": "electron-builder --publish never",
    "verify:package": "node scripts/verify-package.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.10.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^4.0.1",
    "framer-motion": "^12.43.0",
    "lucide-react": "^0.577.0",
    "playwright-core": "^1.64.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vitest": "^5.0.5",
    "zustand": "^5.0.15"
  }
